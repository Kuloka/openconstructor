{
  // Cloudflare static-site deploy: `npm run deploy` builds and uploads dist/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openconstructor",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "openconstructor.pw", "custom_domain": true },
    { "pattern": "www.openconstructor.pw", "custom_domain": true }
  ]
}
