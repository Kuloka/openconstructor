{
  // Cloudflare deploy: `npm run deploy` builds and uploads dist/.
  // worker.js serves published pages at /p/<slug> and the free AI at /api/ai; everything else is the static site.
  // Secret (kept out of this file): GROQ_API_KEY, set once with `npx wrangler secret put GROQ_API_KEY`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openconstructor",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "ai": { "binding": "AI" }, // Cloudflare Workers AI: keyless fallback for the free AI
  // Roblox Studio sync: /api/sync stores the latest UI per sync code (see roblox/)
  "kv_namespaces": [{ "binding": "SYNC", "id": "bf90e3c4a70b48f6af0f63d9fc3dd529" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/p/*", "/api/*"]
  },
  // Public values (the anon key is safe to expose; access is governed by RLS)
  "vars": {
    "SUPABASE_URL": "https://cxzdfjccdggeudsjxjbp.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN4emRmamNjZGdnZXVkc2p4amJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM5ODY5MDcsImV4cCI6MjEwOTU2MjkwN30.5hP7ZGisLhXKGrxc2598Jhn9BuKsaraRMYNcmx9ldRY"
  },
  "routes": [
    { "pattern": "openconstructor.pw", "custom_domain": true },
    { "pattern": "www.openconstructor.pw", "custom_domain": true }
  ]
}
