# Copy this file to .env.local and fill in your own values.
# Supabase → Project Settings → API. The anon key is public and safe to ship in the frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional: link to a donation page (Ko-fi, GitHub Sponsors, etc.)
VITE_DONATE_URL=

# Optional: crypto wallets for donations — coin|network|PUBLIC address, separated by ;
# Never put a seed phrase or private key here!
VITE_CRYPTO_WALLETS=
